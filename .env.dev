# Environment Configuration Template
# Copy this file to .env and fill in your values

# API Configuration (if you plan to add backend integration)
API_URL=https://api.example.com
API_TIMEOUT=30000

# Analytics (optional - for tracking user behavior)
# Uncomment and configure if you want to add analytics
# ANALYTICS_ENABLED=false
# ANALYTICS_KEY=your_analytics_key_here

# Feature Flags (optional - for gradual feature rollouts)
# ENABLE_PREMIUM_FEATURES=false
# ENABLE_SOCIAL_SHARING=false

# App Configuration
# APP_ENV=development
# APP_VERSION=1.0.0

# Debug Settings
# DEBUG_MODE=true
# SHOW_DEV_MENU=true
